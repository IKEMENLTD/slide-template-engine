{
  "name": "slide-template-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "phase0": "tsx scripts/phase0/run-all.ts",
    "test": "vitest run",
    "slidegen": "tsx src/cli.ts",
    "template": "python3 scripts/build-provisional-template.py",
    "typecheck": "tsc -p . && tsc -p web",
    "app": "tsx src/app/server.ts",
    "app:build": "vite build web",
    "app:dev": "vite web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@hono/node-server": "2.1.4",
    "@xmldom/xmldom": "0.9.12",
    "budoux": "0.10.1",
    "fontkit": "2.0.4",
    "hono": "4.13.13",
    "mammoth": "1.13.0",
    "onnxruntime-node": "1.30.0",
    "pptx-automizer": "0.9.4",
    "sharp": "0.35.5",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "bin": {
    "slidegen": "src/cli.ts"
  }
}
